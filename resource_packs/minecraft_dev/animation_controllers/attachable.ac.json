{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.combo": {
            "states": {
                "default": {
                    "on_entry": ["v.combo_count = 0;"],
                    "animations": ["idle_fpp"],
                    "transitions": [{"combo": "v.trigger ? t.player_attacking : t.is_using_item"}],
                    "blend_transition": 0.0
                },
                "combo": {
                    "animations": [
                        {"combo1_fpp": "v.combo_count == 0"},
                        {"combo2_fpp": "v.combo_count == 1"},
                        {"combo3_fpp": "v.combo_count == 2"},
                        {"combo4_fpp": "v.combo_count == 3"},
                        {"combo5_fpp": "v.combo_count == 4"},
                        {"combo6_fpp": "v.combo_count == 5"},
                        {"combo7_fpp": "v.combo_count == 6"},
                        {"combo8_fpp": "v.combo_count == 7"},
                        {"combo9_fpp": "v.combo_count == 8"},
                        {"combo10_fpp": "v.combo_count == 9"},
                        {"combo1_tpp": "v.combo_count == 0"},
                        {"combo2_tpp": "v.combo_count == 1"},
                        {"combo3_tpp": "v.combo_count == 2"},
                        {"combo4_tpp": "v.combo_count == 3"},
                        {"combo5_tpp": "v.combo_count == 4"},
                        {"combo6_tpp": "v.combo_count == 5"},
                        {"combo7_tpp": "v.combo_count == 6"},
                        {"combo8_tpp": "v.combo_count == 7"},
                        {"combo9_tpp": "v.combo_count == 8"},
                        {"combo10_tpp": "v.combo_count == 9"}
                    ],
                    "transitions": [
                        {
                            "wait": "q.any_animation_finished"
                        }
                    ],
                    "blend_transition": 0.0
                },
                "wait": {
                    "on_entry": [
                        "v.combo_count = v.combo_count + 1;"
                    ],
                    "animations": ["idle_fpp"],
                    "transitions": [
                        {"default": "q.any_animation_finished || v.combo_count == v.combo_max"},
                        {"combo": "v.trigger ? t.player_attacking : t.is_using_item"}
                    ],
                    "blend_transition": 0.0
                }
            }
        }
    }
}