{
    "format_version": "1.13.0",
    "minecraft:feature_rules": {
        "description": {
            "identifier": "feature_dev:entry",
            "places_feature": "feature_dev:root"
        },
        "conditions": {
            "placement_pass": "first_pass",
            "minecraft:biome_filter": [
                {
                    "all_of": [
                        {
                            "test": "has_biome_tag",
                            "operator": "==",
                            "value": "overworld"
                        }
                    ]
                }
            ]
        },
        "distribution": {
            "iterations": 256,
            "x": {
                "distribution": "fixed_grid",
                "extent": [
                    0,
                    15
                ]
            },
            "y": "t.HEIGHT_MAP = q.heightmap(v.worldx, v.worldz); return t.HEIGHT_MAP;",
            "z": {
                "distribution": "fixed_grid",
                "extent": [
                    0,
                    15
                ]
            }
        }
    }
}
