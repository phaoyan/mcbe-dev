      "identifier": "ns_ds:terrain_locator",
      "type": "minecraft:scatter_feature",
      "data": {
        "description": {
          "identifier": "ns_ds:terrain_locator"
        },
        "distribution": {
          "iterations": "t.grid = 1024;\nt.center_x = 512;\nt.center_z = 512;\nt.base_radius = 128.0;\nt.modx = math.mod(v.originx, t.grid);\nt.modz = math.mod(v.originz, t.grid);\nt.dx = t.modx - t.center_x;\nt.dz = t.modz - t.center_z;\nt.dist_sq_center = t.dx * t.dx + t.dz * t.dz;\nreturn t.dist_sq_center < 128 * 128;\n",
          "scatter_chance": 100,
          "x": 0,
          "y": 63,
          "z": 0
        },
        "places_feature": "ns_ds:terrain_shaper"
      },
      "children": [
        {
          "identifier": "ns_ds:terrain_shaper",
          "type": "minecraft:scatter_feature",
          "data": {
            "description": {
              "identifier": "ns_ds:terrain_shaper"
            },
            "distribution": {
              "iterations": "t.scale = 100.0;\nt.octaves = 4;\nt.persistence = 0.5;\nt.lacunarity = 2.0;\nt.island_spread = 1.0;\nt.center_strength = 2.0;\nt.satellite_spread = 0.6;\nt.satellite_strength = 1.5;\nt.satellite_distance = 0.7;\n\nt.noise = 0; t.amp = 1; t.freq = 1.0 / t.scale;\nloop(t.octaves, {\n    t.noise = t.noise + t.amp * query.noise(v.originx * t.freq, v.originz * t.freq);\n    t.amp = t.amp * t.persistence; t.freq = t.freq * t.lacunarity;\n});\n\nt.noise = (t.noise + 1.0) / 2.0;\n\nt.spread_sq = math.pow(t.island_spread * t.base_radius, 2);\n\nt.g_center = math.clamp(1.0 - t.dist_sq_center / t.spread_sq, 0, 1) * t.center_strength;\n\nt.grad = t.g_center;\nt.noise_center = math.clamp((t.noise + t.grad) / (1.0 + t.center_strength), 0, 1);\nt.center_dist = 1-t.noise_center;\n\nt.threshold_1 = 0.4;\nt.threshold_2 = 0.5;\nt.threshold_3 = 0.6;\nt.threshold_4 = 0.7;\nt.layer = \nt.center_dist < t.threshold_1 ? 1 :\nt.center_dist < t.threshold_2 ? 2 :\nt.center_dist < t.threshold_3 ? 3 :\nt.center_dist < t.threshold_4 ? 4 : 0;\nt.range = t.center_dist < t.threshold_4;\nt.rel_noise = \nt.center_dist < t.threshold_1 ? t.center_dist * 2.5 :\nt.center_dist < t.threshold_2 ? (t.center_dist - 0.4) * 10 :\nt.center_dist < t.threshold_3 ? (t.center_dist - 0.5) * 10 :\nt.center_dist < t.threshold_4 ? (t.center_dist - 0.6) * 10 : 0;\n\nreturn 1;",
              "scatter_chance": 100,
              "x": 0,
              "y": 0,
              "z": 0
            },
