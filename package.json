{
  "name": "scripting-starter",
  "version": "0.1.0",
  "productName": "Minecraft TypeScript Starter Project",
  "description": "Minecraft TypeScript Starter Project",
  "private": true,
  "devDependencies": {
    "@minecraft/core-build-tasks": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "eslint-plugin-minecraft-linting": "^2.0.1",
    "source-map": "^0.7.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "lint": "just-scripts lint",
    "build": "just-scripts build",
    "clean": "just-scripts clean",
    "local-deploy": "just-scripts local-deploy",
    "mcaddon": "just-scripts mcaddon",
    "enablemcloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
    "enablemcpreviewloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476",
    "tools": "ts-node tools/main.ts",
    "dts": "just-scripts local-deploy-script",
    "drp": "just-scripts local-deploy-rp",
    "dbp": "just-scripts local-deploy-bp",
    "dall": "just-scripts local-deploy-bp && just-scripts local-deploy-rp && just-scripts local-deploy-script",
    "tbp": "ts-node tools/main.ts batch-bp",
    "trp": "ts-node tools/main.ts batch-rp",
    "tbbmodel": "ts-node tools/main.ts bbmodel",
    "tbbpack": "ts-node tools/main.ts bbpack",
    "tall": "ts-node tools/main.ts all",
    "rp": "npm run tbbmodel && npm run drp && npm run dts",
    "all": "npm run tall && npm run dall"
  },
  "dependencies": {
    "@minecraft/math": "^2.2.7",
    "@minecraft/server": "^2.0.0",
    "@minecraft/server-ui": "^2.0.0",
    "@minecraft/vanilla-data": "^1.21.90",
    "uuid": "^9.0.0"
  }
}